# =============================================================================
# Variables del backend para la aplicación LOCAL (SQLite).
# iniciar.bat crea backend/.env automáticamente la primera vez (con un
# JWT_SECRET aleatorio). Este archivo sirve como referencia / desarrollo:
#   cp .env.example .env
# =============================================================================
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=debug
SWAGGER_ENABLED=true

# Base de datos SQLite (ruta relativa a la carpeta backend/)
DB_PATH=data/pintotech.sqlite
MIGRATIONS_DIR=../database/migrations
# Interfaz compilada que sirve el backend (npm run build en la raíz)
FRONTEND_DIST=../dist

# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambie-este-secreto-de-desarrollo-por-uno-aleatorio-de-48-bytes
JWT_EXPIRES_IN=8h

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
UPLOAD_MAX_FILE_SIZE_MB=8
UPLOAD_MAX_FILES=6

# Datos de la empresa que aparecen en los PDF
COMPANY_NAME=PINTOTECH
COMPANY_ADDRESS=Quito, Ecuador
COMPANY_PHONE=0999999999
COMPANY_EMAIL=contacto@pintotech.example.com
COMPANY_WEBSITE=
WORK_ORDER_PREFIX=PT
APP_TIMEZONE=America/Guayaquil

# Administrador inicial (se crea al arrancar si la base no tiene usuarios)
ADMIN_EMAIL=admin@pintotech.local
ADMIN_PASSWORD=Cambiar2026
ADMIN_NAME=Administrador PINTOTECH
