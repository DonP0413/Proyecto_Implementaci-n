# =============================================================================
# Variables del backend para desarrollo LOCAL sin Docker (npm run start:dev).
# Copiar a backend/.env  ->  cp .env.example .env
# Con Docker Compose se usa el .env de la RAÍZ del repositorio.
# =============================================================================
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=debug
SWAGGER_ENABLED=true
APP_PUBLIC_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USER=pintotech
DB_PASSWORD=pintotech_dev_password
DB_NAME=pintotech
DB_SSL=false
DB_POOL_MAX=10
MIGRATIONS_DIR=../database/migrations

# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambie-este-secreto-de-desarrollo-por-uno-aleatorio-de-48-bytes
JWT_EXPIRES_IN=8h

# console = no envía correos (los registra en el log). mailgun = envío real.
MAIL_DRIVER=console
MAIL_FROM=PINTOTECH <no-reply@mg.example.com>
MAIL_REPLY_TO=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_REGION=us
# Guardar el HTML de los correos simulados para revisarlos en el navegador
MAIL_PREVIEW_DIR=./storage/mail-preview

NOTIFICATIONS_WORKER_ENABLED=true
NOTIFICATIONS_POLL_INTERVAL_MS=15000
NOTIFICATIONS_MAX_ATTEMPTS=5
NOTIFICATIONS_BASE_DELAY_SECONDS=30

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
UPLOAD_MAX_FILE_SIZE_MB=8
UPLOAD_MAX_FILES=6

COMPANY_NAME=PINTOTECH
COMPANY_ADDRESS=Quito, Ecuador
COMPANY_PHONE=0999999999
COMPANY_EMAIL=contacto@pintotech.example.com
COMPANY_WEBSITE=
WORK_ORDER_PREFIX=PT
APP_TIMEZONE=America/Guayaquil

ADMIN_EMAIL=admin@pintotech.local
ADMIN_PASSWORD=Cambiar2026
ADMIN_NAME=Administrador PINTOTECH
