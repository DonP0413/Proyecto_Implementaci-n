<h2 style="margin:0 0 12px;font-size:20px;color:#0f4c81;">Confirmación de entrega</h2>
<p>Estimado/a <strong>{{client.fullName}}</strong>:</p>
<p>Confirmamos la entrega de su equipo. Gracias por confiar en {{company.name}}.</p>

<table role="presentation" width="100%" cellpadding="8" cellspacing="0" style="border-collapse:collapse;margin:16px 0;background:#eff6ff;border-radius:6px;">
  <tr><td style="font-size:13px;color:#6b7280;">ID de trabajo</td><td style="font-size:18px;font-weight:bold;color:#0f4c81;">{{workOrder.code}}</td></tr>
  <tr><td style="font-size:13px;color:#6b7280;">Fecha de entrega</td><td>{{delivery.deliveredAt}}</td></tr>
  <tr><td style="font-size:13px;color:#6b7280;">Equipo</td><td>{{equipment.typeName}} {{equipment.brand}} {{equipment.model}}{{#if equipment.serialNumber}} (S/N {{equipment.serialNumber}}){{/if}}</td></tr>
  <tr><td style="font-size:13px;color:#6b7280;">Valor cobrado</td><td style="font-size:18px;font-weight:bold;">{{delivery.amountCharged}}</td></tr>
  <tr><td style="font-size:13px;color:#6b7280;">Retirado por</td><td>{{delivery.receivedByName}}</td></tr>
</table>

<h3 style="font-size:16px;margin:20px 0 8px;">Servicio realizado</h3>
<p style="margin:0;">{{nl2br delivery.workSummary}}</p>

<h3 style="font-size:16px;margin:20px 0 8px;">Condiciones de entrega</h3>
<p style="margin:0;">{{nl2br delivery.returnCondition}}</p>

<h3 style="font-size:16px;margin:20px 0 8px;">Accesorios entregados</h3>
{{#if deliveredAccessories.length}}
<ul style="margin:0;padding-left:20px;">
  {{#each deliveredAccessories}}<li>{{name}} (x{{quantity}})</li>{{/each}}
</ul>
{{else}}
<p style="margin:0;">Sin accesorios.</p>
{{/if}}
{{#if delivery.accessoriesNotes}}<p style="margin-top:8px;">{{delivery.accessoriesNotes}}</p>{{/if}}

{{#if hasPhotos}}<p style="margin-top:16px;">Adjuntamos la fotografía del equipo al momento de la entrega.</p>{{/if}}
