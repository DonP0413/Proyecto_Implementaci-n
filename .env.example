# =============================================================================
# .env.example — Variables para Docker Compose (raíz del repositorio).
#   cp .env.example .env     y completar los valores marcados con <CAMBIAR>.
# NUNCA versionar .env. En CI/CD los secretos viven en GitHub Environments.
# =============================================================================

# ---- General ----
COMPOSE_PROJECT_NAME=pintotech
NODE_ENV=production
APP_VERSION=dev
LOG_LEVEL=info
# Puerto público del frontend (Nginx). La API se accede vía /api en el mismo origen.
FRONTEND_PORT=8080
APP_PUBLIC_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
SWAGGER_ENABLED=true

# ---- PostgreSQL ----
POSTGRES_USER=pintotech
POSTGRES_PASSWORD=<CAMBIAR-password-segura>
POSTGRES_DB=pintotech
# Puerto expuesto al host SOLO para desarrollo (DBeaver/pgAdmin). En prod no se expone.
POSTGRES_HOST_PORT=5432
DB_POOL_MAX=10

# ---- Seguridad ----
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<CAMBIAR-minimo-32-caracteres-aleatorios>
JWT_EXPIRES_IN=8h
THROTTLE_LIMIT=120
METRICS_TOKEN=

# ---- Mailgun ----
# console = sólo log (dev/QA) | mailgun = envío real (staging/prod)
MAIL_DRIVER=console
MAIL_FROM=PINTOTECH <no-reply@mg.tudominio.com>
MAIL_REPLY_TO=contacto@tudominio.com
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.tudominio.com
MAILGUN_REGION=us

# ---- Notificaciones ----
NOTIFICATIONS_WORKER_ENABLED=true
NOTIFICATIONS_MAX_ATTEMPTS=5
NOTIFICATIONS_BASE_DELAY_SECONDS=30

# ---- Archivos ----
UPLOAD_MAX_FILE_SIZE_MB=8
UPLOAD_MAX_FILES=6

# ---- Datos de la empresa (comprobantes y correos) ----
COMPANY_NAME=PINTOTECH
COMPANY_ADDRESS=Quito, Ecuador
COMPANY_PHONE=0999999999
COMPANY_EMAIL=contacto@tudominio.com
COMPANY_WEBSITE=
WORK_ORDER_PREFIX=PT
APP_TIMEZONE=America/Guayaquil

# ---- Administrador inicial (se crea una sola vez con RUN_SEED=true) ----
RUN_MIGRATIONS=true
RUN_SEED=true
ADMIN_EMAIL=admin@pintotech.local
ADMIN_PASSWORD=<CAMBIAR-Clave2026>
ADMIN_NAME=Administrador PINTOTECH

# ---- Imágenes (producción: GHCR) ----
REGISTRY=ghcr.io/<owner>
IMAGE_TAG=latest
